    {
      "name": "a7202d46",
      "displayName": "portfolio_summary",
      "queryLines": [
        "WITH scores AS (\n",
        "    SELECT\n",
        "        prediction_month,\n",
        "        alert,\n",
        "        calibrated_risk,\n",
        "        scored_at\n",
        "    FROM workspace.mortgage_risk.monthly_risk_scores\n",
        "    WHERE population = 'All eligible loans'\n",
        "      AND model_version = 'gbt_v1'\n",
        "      AND calibration_version = 'gbt_v1_calibration_v1'\n",
        "      AND alert_fraction = 0.05\n",
        "),\n",
        "\n",
        "latest_scores AS (\n",
        "    SELECT *\n",
        "    FROM scores\n",
        "    WHERE prediction_month = (\n",
        "        SELECT MAX(prediction_month)\n",
        "        FROM scores\n",
        "    )\n",
        ")\n",
        "\n",
        "SELECT\n",
        "    MAX(prediction_month) AS feature_month,\n",
        "    COUNT(*) AS eligible_loans,\n",
        "    SUM(alert) AS flagged_loans,\n",
        "\n",
        "    ROUND(\n",
        "        100.0 * SUM(alert) / NULLIF(COUNT(*), 0),\n",
        "        2\n",
        "    ) AS alert_share_pct,\n",
        "\n",
        "    ROUND(\n",
        "        100.0 * AVG(calibrated_risk),\n",
        "        4\n",
        "    ) AS average_estimated_risk_pct,\n",
        "\n",
        "    MAX(scored_at) AS last_scored_at\n",
        "FROM latest_scores"
      ]
    },
    {
      "name": "787de527",
      "displayName": "alerts_by_state",
      "queryLines": [
        "WITH scores AS (\n",
        "    SELECT\n",
        "        prediction_month,\n",
        "        state,\n",
        "        alert\n",
        "    FROM workspace.mortgage_risk.monthly_risk_scores\n",
        "    WHERE population = 'All eligible loans'\n",
        "      AND model_version = 'gbt_v1'\n",
        "      AND calibration_version = 'gbt_v1_calibration_v1'\n",
        "      AND alert_fraction = 0.05\n",
        ")\n",
        "\n",
        "SELECT\n",
        "    state,\n",
        "    COUNT(*) AS eligible_loans,\n",
        "    SUM(alert) AS flagged_loans\n",
        "FROM scores\n",
        "WHERE prediction_month = (\n",
        "    SELECT MAX(prediction_month)\n",
        "    FROM scores\n",
        ")\n",
        "GROUP BY state\n",
        "ORDER BY flagged_loans DESC, state\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "11f6bdd3",
      "displayName": "risk_distribution",
      "queryLines": [
        "WITH scores AS (\n",
        "    SELECT\n",
        "        prediction_month,\n",
        "        calibrated_risk\n",
        "    FROM workspace.mortgage_risk.monthly_risk_scores\n",
        "    WHERE population = 'All eligible loans'\n",
        "      AND model_version = 'gbt_v1'\n",
        "      AND calibration_version = 'gbt_v1_calibration_v1'\n",
        "      AND alert_fraction = 0.05\n",
        "),\n",
        "\n",
        "risk_bands AS (\n",
        "    SELECT\n",
        "        CASE\n",
        "            WHEN calibrated_risk < 0.002\n",
        "                THEN '01. Below 0.2%'\n",
        "            WHEN calibrated_risk < 0.005\n",
        "                THEN '02. 0.2% to below 0.5%'\n",
        "            WHEN calibrated_risk < 0.01\n",
        "                THEN '03. 0.5% to below 1%'\n",
        "            WHEN calibrated_risk < 0.02\n",
        "                THEN '04. 1% to below 2%'\n",
        "            WHEN calibrated_risk < 0.05\n",
        "                THEN '05. 2% to below 5%'\n",
        "            WHEN calibrated_risk < 0.10\n",
        "                THEN '06. 5% to below 10%'\n",
        "            ELSE '07. 10% or more'\n",
        "        END AS risk_band\n",
        "    FROM scores\n",
        "    WHERE prediction_month = (\n",
        "        SELECT MAX(prediction_month)\n",
        "        FROM scores\n",
        "    )\n",
        ")\n",
        "\n",
        "SELECT\n",
        "    SUBSTRING(risk_band, 5) AS risk_label,\n",
        "    CAST(SUBSTRING(risk_band, 1, 2) AS INT) AS risk_order,\n",
        "    COUNT(*) AS loan_count\n",
        "FROM risk_bands\n",
        "GROUP BY risk_band\n",
        "ORDER BY risk_order"
      ]
    },
    {
      "name": "98774c5d",
      "displayName": "top_review_loans",
      "queryLines": [
        "WITH scores AS (\n",
        "    SELECT\n",
        "        loan_id,\n",
        "        prediction_month,\n",
        "        risk_rank,\n",
        "        state,\n",
        "        delinquency_months,\n",
        "        fico,\n",
        "        ltv,\n",
        "        calibrated_risk,\n",
        "        alert\n",
        "    FROM workspace.mortgage_risk.monthly_risk_scores\n",
        "    WHERE population = 'All eligible loans'\n",
        "      AND model_version = 'gbt_v1'\n",
        "      AND calibration_version = 'gbt_v1_calibration_v1'\n",
        "      AND alert_fraction = 0.05\n",
        ")\n",
        "\n",
        "SELECT\n",
        "    risk_rank,\n",
        "    loan_id,\n",
        "    prediction_month,\n",
        "    state,\n",
        "    delinquency_months,\n",
        "    fico,\n",
        "    ltv,\n",
        "    ROUND(\n",
        "        100.0 * calibrated_risk,\n",
        "        2\n",
        "    ) AS estimated_12m_risk_pct\n",
        "FROM scores\n",
        "WHERE prediction_month = (\n",
        "    SELECT MAX(prediction_month)\n",
        "    FROM scores\n",
        ")\n",
        "  AND alert = 1\n",
        "ORDER BY risk_rank\n",
        "LIMIT 100"
      ]
    },
    {
      "name": "c4965b1a",
      "displayName": "test_model_performance",
      "queryLines": [
        "SELECT\n",
        "    prediction_month,\n",
        "    model,\n",
        "    ROUND(100.0 * recall, 2) AS recall_pct,\n",
        "    ROUND(100.0 * precision, 2) AS precision_pct\n",
        "FROM workspace.mortgage_risk.test_monthly_alert_comparison_gbt_lr_v1\n",
        "WHERE population = 'All eligible loans'\n",
        "  AND prediction_month BETWEEN DATE '2024-01-01'\n",
        "                           AND DATE '2025-03-01'\n",
        "ORDER BY prediction_month, model"
      ]
    },
    {
      "name": "53dd3989",
      "displayName": "current_loan_recall",
      "queryLines": [
        "SELECT\n",
        "    model,\n",
        "    ROUND(100.0 * recall, 2) AS recall_pct,\n",
        "    ROUND(100.0 * precision, 2) AS precision_pct,\n",
        "    events,\n",
        "    events_caught\n",
        "FROM workspace.mortgage_risk.test_alert_comparison_gbt_lr_v1\n",
        "WHERE population = 'Current status 00'\n",
        "ORDER BY recall DESC"
      ]
    },
    {
      "name": "21dd155d",
      "displayName": "test_risk_calibration",
      "queryLines": [
        "WITH risk_bands AS (\n",
        "    SELECT\n",
        "        calibrated_risk,\n",
        "        label_12m,\n",
        "        CASE\n",
        "            WHEN calibrated_risk < 0.002 THEN '01: Below 0.2%'\n",
        "            WHEN calibrated_risk < 0.005 THEN '02: 0.2% to below 0.5%'\n",
        "            WHEN calibrated_risk < 0.01 THEN '03: 0.5% to below 1%'\n",
        "            WHEN calibrated_risk < 0.02 THEN '04: 1% to below 2%'\n",
        "            WHEN calibrated_risk < 0.05 THEN '05: 2% to below 5%'\n",
        "            WHEN calibrated_risk < 0.10 THEN '06: 5% to below 10%'\n",
        "            ELSE '07: 10% or more'\n",
        "        END AS risk_band\n",
        "    FROM workspace.mortgage_risk.test_scores_gbt_v1\n",
        "    WHERE prediction_month BETWEEN DATE '2024-01-01'\n",
        "                               AND DATE '2025-03-01'\n",
        ")\n",
        "\n",
        "SELECT\n",
        "    SUBSTRING(risk_band, 5) AS risk_label,\n",
        "    CAST(SUBSTRING(risk_band, 1, 2) AS INT) AS risk_order,\n",
        "    ROUND(100.0 * AVG(calibrated_risk), 2) AS estimated_risk_pct,\n",
        "    ROUND(100.0 * AVG(label_12m), 2) AS observed_event_rate_pct,\n",
        "    COUNT(*) AS observations,\n",
        "    SUM(label_12m) AS events\n",
        "FROM risk_bands\n",
        "GROUP BY risk_band\n",
        "ORDER BY risk_order"
      ]
    },
    {
      "name": "acb16fc9",
      "displayName": "Monthly Mortgage Risk Summary for Eligible Loans",
      "queryLines": [
        "SELECT\n",
        "    prediction_month,\n",
        "    COUNT(*) AS eligible_loans,\n",
        "    SUM(alert) AS flagged_loans,\n",
        "    MAX(scored_at) AS last_scored_at\n",
        "FROM workspace.mortgage_risk.monthly_risk_scores\n",
        "WHERE population = 'All eligible loans'\n",
        "  AND model_version = 'gbt_v1'\n",
        "  AND calibration_version = 'gbt_v1_calibration_v1'\n",
        "  AND alert_fraction = 0.05\n",
        "GROUP BY prediction_month\n",
        "ORDER BY prediction_month DESC;"
      ]
    }
  ],
