{
  "datasets": [
    {
      "name": "alert_performance",
      "displayName": "Alert Performance Metrics",
      "config": {
        "source": "workspace.mortgage_risk.test_monthly_alert_comparison_gbt_lr_v1",
        "measures": [
          {
            "name": "total_rows",
            "expr": "SUM(`rows`)"
          },
          {
            "name": "total_events",
            "expr": "SUM(`events`)"
          },
          {
            "name": "total_alerts",
            "expr": "SUM(`alerts`)"
          },
          {
            "name": "events_caught",
            "expr": "SUM(`events_caught`)"
          },
          {
            "name": "avg_precision",
            "expr": "AVG(`precision`)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_recall",
            "expr": "AVG(`recall`)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_lift",
            "expr": "AVG(`lift`)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_event_rate",
            "expr": "AVG(`event_rate`)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Monthly alert performance comparison (precision, recall, lift)",
        "dimensions": [
          {
            "name": "prediction_month",
            "expr": "prediction_month",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          },
          {
            "name": "model",
            "expr": "model"
          },
          {
            "name": "population",
            "expr": "population"
          }
        ]
      }
    },
    {
      "name": "risk_scores",
      "displayName": "Monthly Risk Scores",
      "config": {
        "source": "workspace.mortgage_risk.monthly_risk_scores",
        "measures": [
          {
            "name": "loan_count",
            "expr": "COUNT(1)"
          },
          {
            "name": "alert_count",
            "expr": "SUM(`alert`)"
          },
          {
            "name": "alert_rate",
            "expr": "SUM(`alert`) * 1.0 / COUNT(1)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_risk_score",
            "expr": "AVG(`calibrated_risk`)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 4.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Monthly mortgage risk scores with early-warning alerts",
        "dimensions": [
          {
            "name": "prediction_month",
            "expr": "prediction_month",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
