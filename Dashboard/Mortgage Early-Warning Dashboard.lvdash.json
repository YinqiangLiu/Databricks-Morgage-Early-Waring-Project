          },
          {
            "name": "loan_id",
            "expr": "loan_id"
          },
          {
            "name": "state",
            "expr": "state"
          },
          {
            "name": "purpose",
            "expr": "purpose"
          },
          {
            "name": "occupancy",
            "expr": "occupancy"
          },
          {
            "name": "property_type",
            "expr": "property_type"
          },
          {
            "name": "population",
            "expr": "population"
          },
          {
            "name": "model_version",
            "expr": "model_version"
          },
          {
            "name": "fico",
            "expr": "fico"
          },
          {
            "name": "ltv",
            "expr": "ltv"
          },
          {
            "name": "estimated_ltv",
            "expr": "estimated_ltv"
          },
          {
            "name": "delinquency_months",
            "expr": "delinquency_months"
          },
          {
            "name": "original_upb",
            "expr": "original_upb"
          },
          {
            "name": "balance_ratio",
            "expr": "balance_ratio"
